# Copie para .env e preencha. O .env nao e versionado.
# Em producao, defina no painel da Vercel. Detalhes em IA-HALFTONE.md.

# gemini (gratis, recomendado) ou fal
AI_PROVIDER=gemini

# Provedor Gemini (Google AI Studio)
GEMINI_API_KEY=
GEMINI_HALFTONE_MODEL=

# Provedor fal.ai (cobrado por imagem)
FAL_KEY=
FAL_HALFTONE_MODEL=
FAL_HALFTONE_MODE=
FAL_HALFTONE_LORA_URL=
